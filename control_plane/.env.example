# Copy to .env locally. Never commit the real file.
ENVIRONMENT=production
SECRET_KEY=replace-with-a-random-64-character-secret
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://beyra-ai.com
DATABASE_URL=postgresql+asyncpg://llamagrid:change-me@postgres:5432/llamagrid
POSTGRES_USER=llamagrid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llamagrid
REDIS_URL=redis://redis:6379/0
DISPATCHER_URL=http://<private-dispatcher-bridge-host>:<port>
DISPATCHER_API_KEY=
PUBLIC_MODEL_ID=default-model
PUBLIC_MODEL_DISPLAY_NAME=Configured model
PUBLIC_MODEL_CONTEXT_LENGTH=0
PUBLIC_MODEL_QUANTIZATION=auto
DEFAULT_BACKEND_IPS=
DEFAULT_BACKEND_PORT=8080
CONTROL_PLANE_SUBNET=<private-docker-subnet>
CONTROL_PLANE_GATEWAY=<private-docker-gateway>
AUTO_CREATE_SCHEMA=false
SEED_EXISTING_CLUSTER=true
TIMESCALE_IMAGE=timescale/timescaledb:latest-pg16
NEXT_PUBLIC_CONTROL_PLANE_URL=
