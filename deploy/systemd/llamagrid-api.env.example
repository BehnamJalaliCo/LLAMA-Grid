# Runtime-only deployment configuration. Keep the real file at
# /etc/llamagrid/api.env with mode 0600; never commit it.
LLAMAGRID_API_KEY=<strong-random-secret>
LLAMAGRID_MODEL_NAME=<public-model-id>
LLAMAGRID_MODEL_OWNER=<operator-or-organization>
LLAMAGRID_BACKENDS=<private-worker-a>:<port>,<private-worker-b>:<port>
LLAMAGRID_LISTEN_HOST=127.0.0.1
LLAMAGRID_LISTEN_PORT=18080
LLAMAGRID_REQUEST_TIMEOUT=900
LLAMAGRID_HEALTH_INTERVAL=5
# Only needed when the Docker control-plane bridge is used.
LLAMAGRID_BRIDGE_BIND_HOST=<docker-network-gateway>
LLAMAGRID_BRIDGE_PORT=<bridge-port>
LLAMAGRID_DISPATCHER_TARGET=127.0.0.1:<dispatcher-port>
